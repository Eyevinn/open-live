{
  "name": "open-live",
  "version": "0.1.0",
  "description": "Open Live — central orchestration API server",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.9.0",
    "fastify-type-provider-zod": "^4.0.2",
    "nano": "^10.1.4",
    "ws": "^8.20.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/nano": "^7.0.0",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0",
      "follow-redirects": ">=1.16.0",
      "form-data": ">=4.0.6",
      "fast-uri": ">=3.1.2",
      "ws": ">=8.21.0",
      "qs": ">=6.15.2",
      "@fastify/static": ">=10.1.3",
      "vite": "^8.0.16",
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "brace-expansion": ">=5.0.9",
      "esbuild": ">=0.28.1"
    }
  }
}
